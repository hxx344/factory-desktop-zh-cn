    {
      "field": "name",
      "source": "Super User",
      "target": "超级用户"
    },
    {
      "field": "description",
      "source": "1000+ sessions",
      "target": "至少 1000 个会话"
    },
    {
      "field": "quip",
      "source": "At this point, Droid should be paying rent in your terminal.",
      "target": "到这份上，Droid 都该为长期住在你的终端里交房租了。"
    },
    {
      "field": "name",
      "source": "Power User",
      "target": "资深用户"
    },
    {
      "field": "description",
      "source": "500+ sessions",
      "target": "至少 500 个会话"
    },
    {
      "field": "quip",
      "source": "Your git log is basically a conversation history at this point.",
      "target": "你的 Git 日志简直快成聊天记录了。"
    },
    {
      "field": "name",
      "source": "Getting Started",
      "target": "初入门径"
